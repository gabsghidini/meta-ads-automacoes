# Copie este arquivo para .env. Nunca versione o .env.
# Token com acesso de leitura as suas contas de anuncios.
META_SYSTEM_USER_TOKEN=
META_API_VERSION=v25.0
# Opcional: ID do portfolio empresarial para descoberta de contas.
META_BUSINESS_ID=
# Opcional: IDs de contas a ignorar, separados por virgula, sem act_.
IGNORE_ACCOUNTS=

# Evolution API em execucao, com uma instancia WhatsApp conectada.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
WHATSAPP_INSTANCE=
# Numeros autorizados a receber alertas, com DDI, separados por virgula.
WHATSAPP_RECIPIENT=
# Numeros que receberao as imagens; vazio impede o envio, exceto se
# WHATSAPP_RECIPIENT estiver preenchido ou --destinatario for usado.
RELATORIO_RECIPIENTS=
MIN_SPEND_7D=1
BRAND_NAME=MINHA AGENCIA
